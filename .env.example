# IELTS Buddy 环境变量模板（.env.example）
#
# 使用方法：
#   1. 复制本文件为 .env：   cp .env.example .env
#   2. 用真实值替换占位符（**不要提交 .env**）
#   3. 启动 Web：            ./start_web.sh    （已内置自动加载 .env）
#
# 变量生效顺序（优先级从高到低）：
#   1. shell 直接 export 的环境变量
#   2. 项目根目录 .env 文件（由 dotenv 加载）
#   3. 代码里 hard-code 的默认值
#
# 本文件 (.env.example) 是模板，所有敏感字段都是占位符，可以安全地提交到 GitHub。
# 真正的 .env 在 .gitignore 里，永远不会被 commit。

# =====================================================================
# 1. 运行模式（dev / prod）
# =====================================================================
# dev (默认)：开发模式，缺失 JWT_SECRET 时自动生成临时密钥；admin token 用占位
# prod     ：生产模式，强制要求 JWT_SECRET ≥32 字符 + ADMIN_RESET_TOKEN
IELTS_BUDDY_ENV=dev

# =====================================================================
# 2. Web 服务监听
# =====================================================================
# 监听地址（0.0.0.0 = 接受所有网卡；生产推荐 0.0.0.0 + nginx 反代）
IELTS_BUDDY_WEB_HOST=127.0.0.1

# 监听端口（默认 8000）
IELTS_BUDDY_WEB_PORT=8000

# Web 进程工作目录（用于相对路径解析）
# 默认 .  即项目根目录
# IELTS_BUDDY_WEB_ROOT=.

# =====================================================================
# 3. 数据库
# =====================================================================
# ---- 3.1 Web 端数据库模式 ----
# sqlite (默认)：本地文件 ~/.ielts-buddy/web_data.db，零配置即可运行
# online       ：连接远程 MySQL，需要 DB_URL（适合生产）
IELTS_BUDDY_WEB_DB_MODE=sqlite

# ---- 3.2 Web 端 MySQL 连接串（仅当 DB_MODE=online 时生效）----
# 格式：mysql+pymysql://user:pass@host:port/db?charset=utf8mb4
# 留空 → 走 mysql_repo.py 内置默认（118.190.148.121:3306/ietls_learn_online）
# IELTS_BUDDY_WEB_DB_URL=

# ---- 3.3 Web 端 SQLite 文件覆盖（仅当 DB_MODE=sqlite 时生效）----
# 默认 ~/.ielts-buddy/web_data.db
# 注意：父目录必须可写；首次启动会自动创建。
# IELTS_BUDDY_WEB_SQLITE_PATH=/custom/path/web_data.db

# ---- 3.4 CLI 端数据库（与 Web 端独立，互不影响）----
# CLI 数据库模式：local (SQLite, 默认) 或 online (MySQL)
# 优先级：IELTS_BUDDY_MODE > config.toml [general].mode > local
# IELTS_BUDDY_MODE=local

# CLI 端 MySQL 连接串（仅 CLI 用，Web 端用上面的 WEB_DB_URL）
# 优先级：MYSQL_URL > config.toml [database].mysql_url > 模块默认
# MYSQL_URL=mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4

# ---- 3.5 当前 CLI 用户 ID ----
# v3+：CLI 与 Web 共用 users 表；IELTS_BUDDY_USER_ID 只影响 CLI 会话，Web 用 JWT 中携带的 sub
# 优先级：IELTS_BUDDY_USER_ID > config.toml [database].user_id > 1（单机默认）
# IELTS_BUDDY_USER_ID=1

# =====================================================================
# 4. JWT 鉴权（Web 端）
# =====================================================================
# access token 签名密钥 —— 必须 ≥ 32 字符
# dev 模式：未设置时自动生成临时密钥（**重启后所有 token 失效**）
# prod 模式：强制要求设置
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
IELTS_BUDDY_JWT_SECRET=please-change-me-to-a-random-32-char-secret

# JWT 算法（默认 HS256）
# IELTS_BUDDY_JWT_ALG=HS256

# access token 有效期（秒，默认 3600 = 1 小时）
IELTS_BUDDY_ACCESS_TTL=3600

# refresh token 有效期（秒，默认 604800 = 7 天）
IELTS_BUDDY_REFRESH_TTL=604800

# =====================================================================
# 5. 管理员接口守卫（Web 端）
# =====================================================================
# POST /api/auth/admin/reset-password 的预共享密钥
# dev 模式可省略（用占位 'dev-admin-token'），prod 模式强制要求
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
IELTS_BUDDY_ADMIN_RESET_TOKEN=

# =====================================================================
# 6. Cookie 安全（生产建议）
# =====================================================================
# prod 模式自动启用 secure cookie（COOKIE_SECURE=true），dev 模式关闭
# COOKIE_SECURE 由 IELTS_BUDDY_ENV 自动决定，无需手动设置

# Cookie SameSite 策略（默认 lax）
# IELTS_BUDDY_COOKIE_SAMESITE=lax

# Cookie 名（一般无需修改）
# IELTS_BUDDY_ACCESS_COOKIE=ib_access
# IELTS_BUDDY_REFRESH_COOKIE=ib_refresh

# =====================================================================
# 7. CORS（多域部署时）
# =====================================================================
# 多个 origin 用逗号分隔；留空 = 用内置默认
# IELTS_BUDDY_CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# =====================================================================
# 8. LLM（联网查词 / 文章翻译 / IPA→DJ 音标 / 生词同义反义分析）
# =====================================================================
# 这套配置与 docs/grok_config.json **完全独立** —— AI 批改走 grok.py 子进程，
# 会单独读 docs/grok_config.json。两处配置可以共用同一个 key，也可以分开。
#
# 推荐：把同一组 LLM 配置写在这里 + 也写到 docs/grok_config.json 里
# （避免到处复制 key）

# ---- 8.1 Web 端 LLM ----
# 是否启用：只要下面任意一个变量非空就视为启用 LLM
# 全部留空 → dry-run 模式（前端拿到的是 [DRY-RUN ...] mock 数据）
# API key（必填，去 MiniMax / OpenAI / SiliconFlow 后台复制）
IELTS_BUDDY_LLM_API_KEY=

# OpenAI 兼容 API 的 base URL
# - MiniMax:    https://api.minimaxi.com/v1
# - OpenAI:    https://api.openai.com/v1
# - SiliconFlow: https://api.siliconflow.cn/v1
IELTS_BUDDY_LLM_BASE_URL=https://api.minimaxi.com/v1

# 模型名（base_url 决定可选范围）
# - MiniMax:    MiniMax-M2.7-highspeed（默认）/ MiniMax-M2 / abab6.5s-chat
# - OpenAI:    gpt-4o-mini / gpt-4o / gpt-3.5-turbo
# - SiliconFlow: Qwen/Qwen2.5-7B-Instruct / deepseek-ai/DeepSeek-V2.5
IELTS_BUDDY_LLM_MODEL=MiniMax-M2.7-highspeed

# 单次 LLM 调用超时（秒，默认 30；翻译整段建议 60+）
# IELTS_BUDDY_LLM_TIMEOUT=30

# ---- 8.2 AI 批改用的 LLM（走 docs/grok.py 子进程）----
# 不读环境变量，直接读 docs/grok_config.json
# 模板：docs/GROK_CONFIG_EXAMPLE.json
# 复制方法：cp docs/GROK_CONFIG_EXAMPLE.json docs/grok_config.json
# 然后填入真实 api_key
#
# ⚠️ docs/grok_config.json 已被 .gitignore 排除（v2.5 之后），
#   但 .env.example 里**不要**把真 key 写进来！

# =====================================================================
# 9. 应用数据目录（CLI 用）
# =====================================================================
# 存放 CLI 的 data.db / vocab_cache.db / config.toml
# 默认 ~/.ielts-buddy
# IELTS_BUDDY_HOME=~/.ielts-buddy

# =====================================================================
# 10. CLI 横幅开关
# =====================================================================
# 设置 IELTS_BUDDY_NO_BANNER=1 可以关闭 CLI 启动时的欢迎语
# IELTS_BUDDY_NO_BANNER=1

# =====================================================================
# 11. 第三方 API（无需 key 的免费词典）
# =====================================================================
# 这些服务不需要 API key，但可以通过环境变量调整行为：
# - dictionaryapi.dev（联网查词）：无配置项
# - api.mymemory.translated.net（中英翻译）：无配置项，但有 5000 字符/天的限流

# =====================================================================
# 12. 调试与日志
# =====================================================================
# 未来可在此加：日志级别、Sentry DSN、性能采样率等
# 当前无自定义配置项

# =====================================================================
# 完整启动示例
# =====================================================================
# 开发：
#   cp .env.example .env
#   # 编辑 .env 填入真实 LLM_API_KEY
#   ./start_web.sh
#
# 生产（示例）：
#   IELTS_BUDDY_ENV=prod \
#   IELTS_BUDDY_JWT_SECRET=$(python -c "import secrets; print(secrets.token_urlsafe(48))") \
#   IELTS_BUDDY_ADMIN_RESET_TOKEN=$(python -c "import secrets; print(secrets.token_urlsafe(32))") \
#   IELTS_BUDDY_WEB_DB_MODE=online \
#   IELTS_BUDDY_WEB_DB_URL='mysql+pymysql://user:pass@db:3306/ielts?charset=utf8mb4' \
#   IELTS_BUDDY_LLM_API_KEY='sk-...' \
#   python -m ielts_buddy.web --host 0.0.0.0 --port 8000