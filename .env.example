# IELTS Buddy Web 服务环境变量模板
#
# 使用方式：
#   1. 复制本文件为 .env：   cp .env.example .env
#   2. 修改 .env 中的实际值（**不要提交 .env**）
#
# 本文件 (.env.example) 是模板，含占位值，可以安全地提交到 GitHub。

# ===== 数据库模式 =====
# sqlite (默认)：本地文件 ~/.ielts-buddy/web_data.db，零配置
# online       ：连接远程 MySQL，需要 DB_URL
IELTS_BUDDY_WEB_DB_MODE=sqlite

# 当 IELTS_BUDDY_WEB_DB_MODE=online 时设置，例：
# IELTS_BUDDY_WEB_DB_URL=mysql+pymysql://user:pass@host:3306/ietls_learn_online?charset=utf8mb4
IELTS_BUDDY_WEB_DB_URL=

# SQLite 文件覆盖（默认 ~/.ielts-buddy/web_data.db）
# IELTS_BUDDY_WEB_SQLITE_PATH=/custom/path/web_data.db

# ===== JWT 密钥 =====
# 必须 ≥ 32 字符的随机字符串。生产环境**强制**要求设置。
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 注意：每次重启 JWT_SECRET 变化都会让所有现有 token 失效！
IELTS_BUDDY_JWT_SECRET=please-change-me-to-a-random-32-char-secret

# JWT access / refresh token 有效期（秒）
IELTS_BUDDY_ACCESS_TTL=3600
IELTS_BUDDY_REFRESH_TTL=604800

# ===== 环境标识 =====
# dev (默认) 或 prod
# prod 模式下会强制要求 JWT_SECRET、ADMIN_RESET_TOKEN 等
IELTS_BUDDY_ENV=dev

# ===== 管理员接口守卫 =====
# POST /api/auth/admin/reset-password 的预共享密钥。
# dev 模式可省略（用占位 'dev-admin-token'），prod 必须设置。
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
IELTS_BUDDY_ADMIN_RESET_TOKEN=

# ===== Cookie 安全（生产建议）=====
# prod 模式自动启用 secure cookie（COSURE_SECURE=true）
# IELTS_BUDDY_COOKIE_SAMESITE=lax

# ===== CORS（多域部署时）=====
# 多个 origin 用逗号分隔
# IELTS_BUDDY_CORS_ORIGINS=http://localhost:3000,https://my-app.com

# ===== Web 服务监听 =====
IELTS_BUDDY_WEB_HOST=127.0.0.1
IELTS_BUDDY_WEB_PORT=8000