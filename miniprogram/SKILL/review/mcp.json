{
  "name": "review",
  "description": "艾宾浩斯复习搭子：智能调度 + 错词本",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {"type": "string", "enum": ["get_due_words", "submit_review", "get_mistakes"]},
      "band": {"type": "integer", "minimum": 5, "maximum": 9},
      "limit": {"type": "integer", "minimum": 1, "maximum": 200},
      "word": {"type": "string"},
      "correct": {"type": "boolean"}
    },
    "required": ["action"]
  }
}