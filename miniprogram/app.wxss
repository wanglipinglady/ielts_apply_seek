/* app.wxss — 全局样式（微信绿 #07C160 主题） */

page {
  background: #F8F8F8;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* 通用容器 */
.container {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

/* 主色按钮 */
.btn-primary {
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
  border: none;
}
.btn-primary[disabled] {
  background: #B5E5C9;
  color: #fff;
}

.btn-secondary {
  background: #fff;
  color: #07C160;
  border: 2rpx solid #07C160;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 30rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 文本辅助 */
.text-muted { color: #999; }
.text-primary { color: #07C160; }
.text-error { color: #F56565; }

/* 列表项 */
.list-item {
  background: #fff;
  padding: 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 26rpx;
}