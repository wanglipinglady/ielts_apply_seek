/* pages/me/tools/index.wxss — 工具集合 v3.9+ / 2026-09-20 */

.tools-container {
  padding: 24rpx;
  background: #F8F8F8;
  min-height: 100vh;
}

.section-title {
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A3A5F;
}

/* 工具宫格 */
.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  margin: 0;
}

.tool-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.tool-name {
  font-size: 24rpx;
  color: #1A3A5F;
  font-weight: 500;
}

/* 番茄钟 */
.pomodoro-card {
  margin-bottom: 32rpx;
  text-align: center;
  padding: 32rpx 24rpx;
}

.pomodoro-display {
  padding: 16rpx;
  background: #F8FCF9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.pomodoro-time {
  font-size: 96rpx;
  font-weight: 700;
  color: #07C160;
  font-family: "Courier New", monospace;
  letter-spacing: 4rpx;
}

.pomodoro-sessions {
  margin-bottom: 16rpx;
}

.sessions-text {
  font-size: 24rpx;
  color: #666;
}

.pomodoro-buttons {
  display: flex;
  gap: 12rpx;
}

.pomodoro-btn {
  flex: 1;
  margin: 0;
}

/* 文章翻译 */
.translate-card {
  padding: 24rpx;
}

.translate-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  background: #FAFAFA;
  border: 2rpx solid #EEE;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.translate-textarea:focus {
  border-color: #07C160;
  background: #fff;
}

.translate-actions {
  margin-bottom: 16rpx;
}

.translate-actions .btn-primary {
  width: 100%;
}

.translate-result {
  border-top: 2rpx solid #F0F0F0;
  padding-top: 16rpx;
}

.result-section {
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A3A5F;
  display: block;
  margin-bottom: 8rpx;
}

.result-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.7;
  display: block;
}

.word-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.word-chip {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: #E8F8EF;
  color: #07C160;
  border-radius: 6rpx;
}