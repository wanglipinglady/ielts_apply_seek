/* pages/me/activate/index.wxss */
.activate-container {
  padding: 32rpx 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #07C160;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  border: 2rpx solid transparent;
}

.input:focus {
  background: #fff;
  border-color: #07C160;
}

.error-message {
  color: #ff4d4f;
  font-size: 26rpx;
  margin: 16rpx 0;
  padding: 12rpx 20rpx;
  background: #fff1f0;
  border-radius: 8rpx;
}

.btn-primary {
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #b7e4c7;
  color: #fff;
}

.activate-btn {
  width: 100%;
}

.form-tip {
  margin-top: 32rpx;
  padding: 20rpx;
  background: #f0f9eb;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

.tip-line {
  display: block;
  margin: 4rpx 0;
}
