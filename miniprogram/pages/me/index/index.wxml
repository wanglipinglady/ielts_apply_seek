<view class="container me-container">
  <!-- 顶部用户卡片 -->
  <view class="user-card">
    <image class="avatar" src="{{avatarSrc}}" />
    <view class="user-info">
      <text class="nickname">{{displayName}}</text>
      <text class="email">{{displayEmail}}</text>
    </view>
  </view>

  <!-- 工具入口：只保留"考试日历"（作文批改/资料下载在小程序体验不佳，移到 Web 端） -->
  <view class="tool-section card">
    <button class="tool-item" bindtap="goExam">
      <text class="tool-icon">📅</text>
      <view class="tool-info">
        <text class="tool-name">考试日历</text>
        <text class="tool-desc">查看近期雅思考试时间</text>
      </view>
      <text class="tool-arrow">›</text>
    </button>
  </view>

  <view class="version-tip">屠鸭口语磨炼 v3.9.0 · 2026 大赛参赛作品</view>

  <button class="btn-secondary logout-btn" bindtap="doLogout">退出登录</button>
</view>
