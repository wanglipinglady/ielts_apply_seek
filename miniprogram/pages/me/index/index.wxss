.me-container {
  background: #F8F8F8;
  min-height: 100vh;
  padding-bottom: 60rpx;
}
.user-card {
  background: linear-gradient(135deg, #07C160 0%, #06A050 100%);
  color: #fff;
  padding: 60rpx 32rpx;
  display: flex;
  align-items: center;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  margin-right: 24rpx;
}
.user-info {
  flex: 1;
}
.nickname {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.email {
  font-size: 22rpx;
  opacity: 0.85;
}
.tool-section {
  margin: 24rpx;
  padding: 0;
}
.tool-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.tool-item:last-child {
  border-bottom: none;
}
.tool-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}
.tool-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.tool-arrow {
  font-size: 40rpx;
  color: #CCC;
}
.btn-logout {
  margin: 32rpx 24rpx;
  background: #fff;
  color: #F56565;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  border: 2rpx solid #F56565;
}
.version-tip {
  text-align: center;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 24rpx;
}