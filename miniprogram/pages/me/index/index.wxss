.me-container {
  background: #F8F8F8;
  min-height: 100vh;
  padding-bottom: 60rpx;
}
.user-card {
  background: linear-gradient(135deg, #07C160 0%, #06A050 100%);
  color: #fff;
  padding: 60rpx 32rpx;
  display: flex;
  align-items: center;
}

/* v4.0+ 调试信息（仅 debug=true 时显示）*/
.debug-info {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-family: monospace;
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  margin-right: 24rpx;
}
.user-info {
  flex: 1;
}
.nickname {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.email {
  font-size: 22rpx;
  opacity: 0.85;
}
.tool-section {
  margin: 24rpx;
  padding: 0;
}
.tool-item {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.tool-item:last-child {
  border-bottom: none;
}
.tool-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}
.tool-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}
.tool-arrow {
  font-size: 40rpx;
  color: #CCC;
}
.btn-logout {
  margin: 32rpx 24rpx;
  background: #fff;
  color: #F56565;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  border: 2rpx solid #F56565;
}
.version-tip {
  text-align: center;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 24rpx;
}

/* v4.0+：PC 端账号区域 */
.pc-account-section {
  margin: 24rpx;
  padding: 32rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #07C160;
}
.hint-text {
  font-size: 26rpx;
  color: #666;
  margin: 16rpx 0 24rpx 0;
  line-height: 1.5;
}
.hint-text-small {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
  text-align: center;
}
.info-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.info-row:last-of-type {
  border-bottom: none;
}
.info-row .label {
  width: 100rpx;
  font-size: 28rpx;
  color: #999;
}
.info-row .value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}
.info-row .action {
  font-size: 26rpx;
  color: #07C160;
  padding: 4rpx 12rpx;
}
.info-row.locked .value {
  color: #999;
}
.lock-icon {
  font-size: 24rpx;
  margin-left: 8rpx;
}
.locked-hint {
  font-size: 22rpx;
  color: #999;
  text-align: center;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}
.btn-primary {
  background: #07C160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 24rpx;
  margin-top: 8rpx;
  font-weight: 500;
}
.btn-primary[disabled] {
  background: #b7e4c7;
  color: #fff;
}