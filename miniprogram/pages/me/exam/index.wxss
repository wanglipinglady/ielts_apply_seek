/* pages/me/exam/index.wxss — 考试日历 v3.9+ / 2026-09-20 */

.exam-container {
  padding: 24rpx;
  background: #F8F8F8;
  min-height: 100vh;
}

.next-exam {
  background: linear-gradient(135deg, #4A6FE7 0%, #3555C5 100%);
  color: #fff;
  margin-bottom: 24rpx;
  padding: 32rpx 24rpx;
  border-radius: 16rpx;
}

.next-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.next-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.next-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(255,255,255,0.25);
}

.next-tag.academic { background: rgba(255,200,100,0.4); }
.next-tag.general { background: rgba(150,255,200,0.4); }
.next-tag.ukvi { background: rgba(255,150,150,0.4); }

.next-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.next-date {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.countdown-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.countdown-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 80rpx;
}

.countdown-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.countdown-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.countdown-sep {
  font-size: 40rpx;
  margin: 0 8rpx;
  opacity: 0.7;
}

.next-tip {
  font-size: 24rpx;
  opacity: 0.85;
  text-align: center;
  padding: 8rpx 16rpx;
  background: rgba(0,0,0,0.15);
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.section-title {
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A3A5F;
}

.exam-list {
  margin-bottom: 24rpx;
}

.exam-item {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.exam-row {
  display: flex;
  align-items: flex-start;
}

.exam-date-col {
  width: 120rpx;
  text-align: center;
  border-right: 2rpx solid #F0F0F0;
  padding-right: 16rpx;
  margin-right: 16rpx;
}

.exam-month {
  font-size: 22rpx;
  color: #07C160;
  font-weight: 500;
}

.exam-day {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A3A5F;
  line-height: 1.2;
  margin: 4rpx 0;
}

.exam-weekday {
  font-size: 20rpx;
  color: #999;
}

.exam-info-col {
  flex: 1;
}

.exam-type-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.exam-type {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
}

.exam-type.academic { background: #FFF9E6; color: #B5841F; }
.exam-type.general { background: #E8F8EF; color: #07C160; }
.exam-type.ukvi { background: #FFE5E5; color: #F56565; }

.exam-status {
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
}

.exam-status.past {
  background: #F0F0F0;
  color: #999;
}

.exam-status.today {
  background: #07C160;
  color: #fff;
}

.exam-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A3A5F;
  display: block;
  margin-bottom: 8rpx;
}

.exam-meta-row {
  display: flex;
  gap: 16rpx;
}

.exam-time {
  font-size: 22rpx;
  color: #666;
}

.exam-fee {
  font-size: 22rpx;
  color: #07C160;
}

.tips-card {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFFEF5 100%);
  border-left: 6rpx solid #FFD24A;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #664D00;
  display: block;
  margin-bottom: 12rpx;
}

.tips-content {
  font-size: 24rpx;
  color: #664D00;
  line-height: 1.7;
}