.review-container {
  padding: 24rpx;
  background: #F8F8F8;
  min-height: 100vh;
}
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}
.tab.active {
  background: #07C160;
  color: #fff;
  font-weight: 600;
}
.card-flip {
  margin-bottom: 32rpx;
  min-height: 400rpx;
}
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 32rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
}
.word {
  font-size: 64rpx;
  font-weight: 700;
  color: #07C160;
  margin-bottom: 16rpx;
  display: block;
}
.phonetic {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 32rpx;
}
.tap-hint {
  font-size: 24rpx;
  color: #BBB;
}
.meaning {
  font-size: 36rpx;
  color: #333;
  display: block;
  margin: 24rpx 0;
  line-height: 1.5;
}
.memory-info {
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}
.action-buttons {
  display: flex;
  gap: 16rpx;
}
.action-buttons .btn-primary,
.action-buttons .btn-secondary {
  flex: 1;
}
.empty {
  text-align: center;
  padding: 100rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #07C160;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #999;
}
.completion {
  text-align: center;
  padding: 60rpx 32rpx;
}
.completion-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}
.completion-title {
  font-size: 36rpx;
  color: #07C160;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}
.completion-sub {
  font-size: 26rpx;
  color: #999;
}
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}