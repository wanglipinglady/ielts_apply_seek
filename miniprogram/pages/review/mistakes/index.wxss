/* pages/review/mistakes/index.wxss — 错词本样式 */

.mistakes-container {
  padding: 24rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #FFE5E5 0%, #FFF5F5 100%);
}

.header-info {
  display: flex;
  align-items: baseline;
}

.header-num {
  font-size: 56rpx;
  font-weight: 700;
  color: #F56565;
  margin-right: 8rpx;
}

.header-label {
  font-size: 24rpx;
  color: #999;
}

.clear-btn {
  font-size: 26rpx;
  color: #F56565;
  padding: 8rpx 16rpx;
  border: 2rpx solid #F56565;
  border-radius: 8rpx;
}

.word-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #F56565;
}

.word-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.word-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A3A5F;
  margin-right: 12rpx;
}

.word-phonetic {
  font-size: 24rpx;
  color: #999;
  font-family: "Times New Roman", serif;
}

.word-meaning {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.word-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.error-count {
  font-size: 22rpx;
  color: #F56565;
  padding: 4rpx 12rpx;
  background: #FFE5E5;
  border-radius: 6rpx;
}

.band-tag {
  font-size: 22rpx;
  color: #07C160;
  padding: 4rpx 12rpx;
  background: #E8F8EF;
  border-radius: 6rpx;
}

.word-actions {
  margin-top: 16rpx;
  border-top: 2rpx solid #F0F0F0;
  padding-top: 16rpx;
}

.action-btn {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  padding: 8rpx 0;
  background: #FAFAFA;
  border-radius: 8rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  display: block;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #CCC;
  display: block;
}

.loading {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}