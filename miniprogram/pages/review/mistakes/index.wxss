.mistakes-container {
  padding: 24rpx;
  background: #F8F8F8;
  min-height: 100vh;
}
.header-tip {
  background: linear-gradient(135deg, #F56565 0%, #E74C3C 100%);
  color: #fff;
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
}
.tip-title {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.tip-sub {
  font-size: 24rpx;
  opacity: 0.9;
}
.mistake-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.mistake-main {
  flex: 1;
}
.word {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}
.meaning {
  font-size: 24rpx;
  color: #999;
}
.mistake-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.wrong-count {
  font-size: 22rpx;
  color: #F56565;
  background: #FFE5E5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.btn-mini {
  font-size: 22rpx;
  background: #07C160;
  color: #fff;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1;
}
.empty {
  text-align: center;
  padding: 100rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
}
.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}
.empty-text {
  font-size: 32rpx;
  color: #07C160;
  font-weight: 600;
  display: block;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #999;
}
.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}