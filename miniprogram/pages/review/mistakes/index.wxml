<view class="container mistakes-container">
  <view class="header-tip card">
    <text class="tip-title">错词本</text>
    <text class="tip-sub">共 {{count}} 个错词（按错次降序）</text>
  </view>

  <view wx:if="{{mistakes.length === 0 && !loading}}" class="empty">
    <text class="empty-icon">✨</text>
    <text class="empty-text">没有错词！</text>
    <text class="empty-sub">继续保持</text>
  </view>

  <view wx:for="{{mistakes}}" wx:key="word" class="mistake-item card">
    <view class="mistake-main">
      <text class="word">{{item.word}}</text>
      <text class="meaning">{{item.meaning}}</text>
    </view>
    <view class="mistake-meta">
      <text class="wrong-count">错 {{item.wrong_count}} 次</text>
      <button class="btn-mini" data-word="{{item.word}}" bindtap="markMastered">掌握</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
</view>