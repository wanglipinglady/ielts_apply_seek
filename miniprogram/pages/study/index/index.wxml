<view class="container study-container">
  <!-- 顶部统计行 -->
  <view class="top-stats card">
    <view class="stat-item">
      <text class="stat-num">{{user?.streak_days || 0}}</text>
      <text class="stat-label">连续天数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{user?.learned_count || 0}}</text>
      <text class="stat-label">已学词数</text>
    </view>
    <view class="stat-item">
      <text class="stat-num">{{user?.due_today || 0}}</text>
      <text class="stat-label">待复习</text>
    </view>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view
      class="tab {{activeTab === 'browse' ? 'active' : ''}}"
      data-tab="browse"
      bindtap="switchTab"
    >浏览</view>
    <view
      class="tab {{activeTab === 'random' ? 'active' : ''}}"
      data-tab="random"
      bindtap="switchTab"
    >抽词</view>
    <view
      class="tab {{activeTab === 'quiz' ? 'active' : ''}}"
      data-tab="quiz"
      bindtap="switchTab"
    >测验</view>
  </view>

  <!-- Band 选择 -->
  <view class="band-bar">
    <text class="band-label">Band：</text>
    <picker mode="selector" range="{{[5,6,7,8,9]}}" value="{{band - 5}}" bindchange="onBandChange">
      <view class="band-value">{{band}}</view>
    </picker>
  </view>

  <!-- 浏览模式 -->
  <view wx:if="{{activeTab === 'browse'}}" class="word-list">
    <view wx:if="{{words.length === 0 && !loading}}" class="empty">没有数据</view>
    <view wx:for="{{words}}" wx:key="word" class="word-item card">
      <view class="word-main">
        <text class="word-text">{{item.word}}</text>
        <text class="word-phonetic">{{item.phonetic}}</text>
      </view>
      <view class="word-meta">
        <text class="word-meaning">{{item.meaning}}</text>
        <text class="word-tag">{{item.pos}} · Band {{item.band}}</text>
      </view>
    </view>
    <view wx:if="{{loading}}" class="loading">加载中…</view>
  </view>

  <!-- 抽词模式 -->
  <view wx:elif="{{activeTab === 'random'}}" class="word-list">
    <view class="random-tip">每次随机抽 5 个 Band {{band}} 的词</view>
    <button class="btn-primary" bindtap="onRandomTap">🎲 抽 5 个词</button>
    <view wx:for="{{words}}" wx:key="word" class="word-item card">
      <view class="word-main">
        <text class="word-text">{{item.word}}</text>
        <text class="word-phonetic">{{item.phonetic}}</text>
      </view>
      <view class="word-meta">
        <text class="word-meaning">{{item.meaning}}</text>
      </view>
    </view>
  </view>

  <!-- 测验模式 -->
  <view wx:elif="{{activeTab === 'quiz'}}" class="word-list">
    <view class="quiz-tip">测验会根据你的艾宾浩斯记录挑薄弱词</view>
    <button class="btn-primary" bindtap="goQuiz">开始测验 →</button>
  </view>
</view>