.study-container {
  padding: 24rpx;
  background: #F8F8F8;
  min-height: 100vh;
}
.top-stats {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
}
.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1;
}
.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 16rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}
.tab.active {
  background: #07C160;
  color: #fff;
  font-weight: 600;
}
.band-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.band-label {
  font-size: 28rpx;
  color: #666;
}
.band-value {
  font-size: 28rpx;
  color: #07C160;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border: 2rpx solid #07C160;
  border-radius: 8rpx;
}
.word-list {
  margin-top: 16rpx;
}
.word-item {
  margin-bottom: 16rpx;
}
.word-main {
  margin-bottom: 12rpx;
}
.word-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #07C160;
  margin-right: 16rpx;
}
.word-phonetic {
  font-size: 24rpx;
  color: #999;
}
.word-meta {
  margin-top: 8rpx;
}
.word-meaning {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}
.word-tag {
  font-size: 22rpx;
  color: #999;
}
.empty, .loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}
.random-tip, .quiz-tip {
  background: #E8F7EE;
  color: #06A050;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}