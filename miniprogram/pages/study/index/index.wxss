/* pages/study/index/index.wxss — 学习首页样式 */

.study-container {
  padding: 24rpx;
}

.top-stats {
  display: flex;
  justify-content: space-around;
  padding: 32rpx 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #07C160;
  line-height: 1.2;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.tab-bar {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  padding: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab.active {
  background: #07C160;
  color: #fff;
  font-weight: 500;
}

.band-bar {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.band-label {
  font-size: 28rpx;
  color: #666;
  margin-right: 16rpx;
}

.band-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #07C160;
  padding: 4rpx 16rpx;
  background: #E8F8EF;
  border-radius: 8rpx;
}

.word-list {
  margin-bottom: 24rpx;
}

.word-item {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.word-main {
  display: flex;
  align-items: baseline;
  margin-bottom: 8rpx;
}

.word-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1A3A5F;
  margin-right: 12rpx;
}

.word-phonetic {
  font-size: 24rpx;
  color: #999;
  font-family: "Times New Roman", serif;
}

.word-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.word-meaning {
  font-size: 28rpx;
  color: #333;
}

.word-tag {
  font-size: 22rpx;
  color: #999;
}

.random-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.quiz-tip {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  margin: 32rpx 0;
  line-height: 1.6;
}

.loading, .empty {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* ===== 内联 random 学习样式 ===== */
.random-init {
  padding: 32rpx 16rpx;
}
.random-count-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0;
}
.random-count-row .label {
  font-size: 28rpx;
  color: #666;
  margin-right: 12rpx;
}
.count-options {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;          /* 4 个按钮放不下自动换行，避免被截断 */
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}
.count-opt {
  display: inline-block;   /* 关键：button 默认是 block，会破坏 flex 布局 */
  width: 96rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border: 1rpx solid #DDD;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  background: #FFF;
  margin: 0;
  padding: 0;
  min-height: auto;
  box-sizing: border-box;
}
.count-opt::after {
  border: none;
}
.count-opt-active {
  background: #07C160;
  color: #FFF;
  border-color: #07C160;
  font-weight: 600;
}
.count-opt-hover {
  /* 给 IDE 模拟器一个明确 hover 反馈，确保第二次点击 IDE 能识别为新事件 */
  opacity: 0.5;
  background: #F0F0F0;
}
.progress-bar-mini {
  width: 100%;
  height: 8rpx;
  background: #F0F0F0;
  border-radius: 4rpx;
  overflow: hidden;
}
.progress-fill-mini {
  height: 100%;
  background: #07C160;
  transition: width 0.3s;
}
.random-card {
  padding: 32rpx 24rpx;
}
.random-progress {
  margin-bottom: 24rpx;
}
.random-progress .progress-text {
  font-size: 22rpx;
  color: #666;
  display: block;
  margin-bottom: 8rpx;
}
.random-word-main {
  text-align: center;
  padding: 60rpx 0 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.random-word-main .word-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
.random-detail {
  padding: 24rpx 0;
  text-align: center;
}
.random-detail .word-phonetic {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}
.random-meaning-box {
  background: #F8F8F8;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.random-meaning-box .meaning-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}
.random-meaning-box .random-meaning {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
}
.random-tags {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}
.random-tags .tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #F0F0F0;
  color: #666;
}
.random-tags .tag.tag-band {
  background: #E8F8EF;
  color: #07C160;
}
.show-answer-btn {
  width: 100%;
  margin-top: 24rpx;
}
.random-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.random-actions button {
  flex: 1;
}
.random-done {
  text-align: center;
  padding: 60rpx 24rpx;
}
.random-done .done-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.random-done .done-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.random-done .done-stats {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
}
.random-done .done-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 24rpx;
}
/* /内联 random 学习样式 */