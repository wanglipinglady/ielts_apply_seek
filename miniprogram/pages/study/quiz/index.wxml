<view class="container quiz-container">
  <!-- 配置区：bindtap + 独立 hover 反馈 -->
  <view class="config-bar card">
    <view class="config-item">
      <text class="label">模式：</text>
      <button class="value-btn" bindtap="onModeChange" hover-class="value-btn-hover">{{modeLabel}}</button>
    </view>
    <view class="config-item">
      <text class="label">Band：</text>
      <button class="value-btn" bindtap="onBandChange" hover-class="value-btn-hover">{{band}}</button>
    </view>
  </view>

  <!-- 进度 -->
  <view wx:if="{{questions.length > 0 && !finished}}" class="progress">
    <text class="progress-text">{{currentIndex + 1}} / {{questions.length}}</text>
    <view class="progress-bar-mini"><view class="progress-fill-mini" style="width: {{progressPercent}}%"></view></view>
  </view>

  <!-- 题目区 -->
  <view wx:if="{{!finished && questions.length > 0}}" class="quiz-body card">
    <view wx:if="{{mode === 'en2zh'}}" class="question-area">
      <text class="question-word">{{questions[currentIndex].word}}</text>
      <text class="question-phonetic">{{questions[currentIndex].phonetic}}</text>
    </view>
    <view wx:if="{{mode === 'zh2en'}}" class="question-area">
      <text class="question-meaning">{{questions[currentIndex].meaning}}</text>
    </view>

    <input
      class="answer-input"
      placeholder="{{placeholder}}"
      value="{{userAnswer}}"
      bindinput="onAnswerInput"
      confirm-type="done"
      bindconfirm="submitAnswer"
    />

    <view class="action-buttons">
      <button class="btn-secondary" bindtap="skip">跳过</button>
      <button class="btn-primary" bindtap="submitAnswer">提交</button>
    </view>
  </view>

  <!-- 完成 -->
  <view wx:if="{{finished}}" class="completion card">
    <text class="completion-icon">🎉</text>
    <text class="completion-title">本轮完成！</text>
    <text class="completion-score">正确率：{{correctCount}} / {{questions.length}}</text>
    <button class="btn-primary" bindtap="restart">再来一轮</button>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:if="{{questions.length === 0 && !loading && !finished}}" class="empty">没有题目</view>

  <!-- 答题反馈弹层 -->
  <view wx:if="{{showResult}}" class="result-overlay">
    <view class="result-card">
      <text class="result-icon">{{resultIcon}}</text>
      <text class="result-title {{resultTitleClass}}">{{resultTitle}}</text>
      <text wx:if="{{!isCorrect}}" class="result-detail">正确答案：{{correctAnswer}}</text>
    </view>
  </view>
</view>
