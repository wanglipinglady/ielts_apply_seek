/* pages/study/quiz/index.wxss — 单词背诵样式 */

.quiz-container {
  padding: 24rpx;
}

.config-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.config-item {
  display: flex;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-right: 8rpx;
}

.value,
.value-btn {
  display: inline-block;  /* 关键：button 默认是 block，会破坏 flex 布局 */
  font-size: 26rpx;
  color: #07C160;
  padding: 4rpx 16rpx;
  background: #E8F8EF;
  border-radius: 8rpx;
  margin: 0;
  min-height: auto;
  line-height: 1.6;
}
.value-btn::after {
  border: none;
}

.progress {
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.progress-bar-mini {
  width: 100%;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill-mini {
  height: 100%;
  background: #07C160;
  transition: width 0.3s;
}

.quiz-body {
  padding: 48rpx 32rpx;
}

.question-area {
  text-align: center;
  margin-bottom: 32rpx;
}

.question-word {
  display: block;
  font-size: 60rpx;
  font-weight: 700;
  color: #1A3A5F;
  margin-bottom: 8rpx;
}

.question-phonetic {
  display: block;
  font-size: 26rpx;
  color: #999;
  font-family: "Times New Roman", serif;
  margin-bottom: 24rpx;
}

.question-meaning {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  color: #1A3A5F;
  line-height: 1.5;
}

.answer-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #EEE;
  border-radius: 12rpx;
  font-size: 30rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  background: #FAFAFA;
}

.answer-input:focus {
  border-color: #07C160;
  background: #fff;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-buttons .btn-secondary,
.action-buttons .btn-primary {
  flex: 1;
}

/* 答题反馈弹层 */
.result-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.result-card {
  width: 80%;
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  text-align: center;
}

.result-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  display: block;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.result-correct {
  color: #1A3A5F;
}

.result-wrong {
  color: #F56565;
}

.result-detail {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  display: block;
}

/* 完成页 */
.completion {
  text-align: center;
  padding: 64rpx 32rpx;
}

.completion-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 16rpx;
}

.completion-title {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}

.completion-score {
  font-size: 32rpx;
  color: #07C160;
  display: block;
  margin-bottom: 32rpx;
}

.loading, .empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}