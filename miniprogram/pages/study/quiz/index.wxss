.quiz-container {
  padding: 24rpx;
  background: #F8F8F8;
  min-height: 100vh;
}
.config-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.config-item {
  display: flex;
  align-items: center;
}
.label {
  font-size: 26rpx;
  color: #666;
}
.value {
  font-size: 28rpx;
  color: #07C160;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border: 2rpx solid #07C160;
  border-radius: 8rpx;
  margin-left: 8rpx;
}
.progress {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
}
.progress-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}
.quiz-body {
  text-align: center;
  padding: 60rpx 32rpx;
  margin-bottom: 24rpx;
}
.question-area {
  margin-bottom: 40rpx;
}
.question-word {
  font-size: 64rpx;
  font-weight: 700;
  color: #07C160;
  display: block;
  margin-bottom: 16rpx;
}
.question-phonetic {
  font-size: 26rpx;
  color: #999;
  display: block;
}
.question-meaning {
  font-size: 40rpx;
  color: #333;
  display: block;
  margin: 24rpx 0;
  line-height: 1.5;
}
.answer-input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}
.action-buttons {
  display: flex;
  gap: 16rpx;
}
.action-buttons .btn-primary,
.action-buttons .btn-secondary {
  flex: 1;
}
.completion {
  text-align: center;
  padding: 80rpx 32rpx;
}
.completion-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}
.completion-title {
  font-size: 36rpx;
  color: #07C160;
  font-weight: 700;
  display: block;
  margin-bottom: 16rpx;
}
.completion-score {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 32rpx;
}
.loading, .empty {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
}