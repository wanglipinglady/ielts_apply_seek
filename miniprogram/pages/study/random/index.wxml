<view class="container"><view class="config-bar card"><view class="config-item"><text class="label">Band：</text><picker mode="selector" range="{{[5,6,7,8,9]}}" value="{{band - 5}}" bindchange="onBandChange"><view class="value">{{band}}</view></picker></view><view class="config-item"><text class="label">数量：</text><picker mode="selector" range="{{[5,10,15,20]}}" value="{{count === 5 ? 0 : count === 10 ? 1 : count === 15 ? 2 : 3}}" bindchange="onCountChange"><view class="value">{{count}}</view></picker></view></view><button class="btn-primary" bindtap="loadRandom">🎲 再抽 {{count}} 个</button><view wx:for="{{words}}" wx:key="word" class="word-item card"><view class="word-main"><text class="word">{{item.word}}</text><text class="phonetic">{{item.phonetic}}</text></view><text class="meaning">{{item.meaning}}</text><text class="tag">{{item.pos}} · Band {{item.band}}</text></view><view wx:if="{{loading}}" class="loading">加载中…</view></view>