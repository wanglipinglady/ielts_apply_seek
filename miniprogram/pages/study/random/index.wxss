/* pages/study/random/index.wxss — 随机刷词（艾宾浩斯学习模式）v3.9+ / 2026-09-20 */

.random-container {
  padding: 24rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 配置区 */
.config-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.config-item {
  display: flex;
  align-items: center;
}

.label {
  font-size: 26rpx;
  color: #666;
  margin-right: 8rpx;
}

.band-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #07C160;
  padding: 4rpx 16rpx;
  background: #E8F8EF;
  border-radius: 8rpx;
}

/* 进度条 */
.progress-bar {
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

/* 单词卡片 */
.word-card {
  flex: 1;
  padding: 48rpx 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  flex-direction: column;
}

.word-main {
  text-align: center;
  margin-bottom: 32rpx;
  padding: 48rpx 16rpx;
}

.word-text {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  color: #1A3A5F;
  letter-spacing: 2rpx;
  word-break: break-all;
}

.word-hint {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 16rpx;
}

.word-detail {
  padding: 24rpx 16rpx;
  border-top: 2rpx solid #F0F0F0;
}

.word-phonetic {
  display: block;
  font-size: 28rpx;
  color: #666;
  font-family: "Times New Roman", serif;
  text-align: center;
  margin-bottom: 24rpx;
}

.word-meaning-box {
  padding: 16rpx;
  background: #F8FCF9;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.meaning-label {
  font-size: 24rpx;
  color: #07C160;
  font-weight: 600;
  margin-right: 8rpx;
}

.word-meaning {
  font-size: 28rpx;
  color: #1A3A5F;
  line-height: 1.6;
}

.word-tags {
  display: flex;
  gap: 8rpx;
  justify-content: center;
  margin-top: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.tag-pos {
  background: #F0F0F0;
  color: #666;
}

.tag-band {
  background: #E8F8EF;
  color: #07C160;
}

/* 按钮 */
.show-answer-btn {
  width: 100%;
  margin-top: auto;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: auto;
}

.action-buttons .btn-secondary,
.action-buttons .btn-primary {
  flex: 1;
  margin: 0;
}

.unknown-btn {
  background: #fff;
  color: #F56565;
  border: 2rpx solid #F56565;
}

.known-btn {
  background: #07C160;
}

/* 完成页 */
.completion {
  text-align: center;
  padding: 64rpx 32rpx;
}

.completion-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 16rpx;
}

.completion-title {
  font-size: 40rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 24rpx;
}

.completion-stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 16rpx;
}

.stat-item {
  font-size: 28rpx;
  color: #333;
}

.completion-tip {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
}

.loading {
  text-align: center;
  padding: 32rpx 0;
  color: #999;
  font-size: 26rpx;
}

.initial-btn-wrapper {
  margin-top: auto;
}

.initial-btn {
  width: 100%;
  margin-top: 24rpx;
}