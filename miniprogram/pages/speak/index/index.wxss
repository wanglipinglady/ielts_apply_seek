.speak-container {
  padding: 24rpx;
  background: #F8F8F8;
  min-height: 100vh;
}
.header-tip {
  background: linear-gradient(135deg, #07C160 0%, #06A050 100%);
  color: #fff;
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
}
.tip-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 16rpx;
}
.tip-title {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 8rpx;
}
.tip-sub {
  font-size: 24rpx;
  opacity: 0.9;
}
.part-card {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 32rpx 24rpx;
}
.part-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}
.part-info {
  flex: 1;
}
.part-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.part-desc {
  font-size: 24rpx;
  color: #999;
}
.part-arrow {
  font-size: 48rpx;
  color: #07C160;
  margin-left: 16rpx;
}
.wip-tip {
  margin-top: 32rpx;
  background: #FFF7E5;
  text-align: center;
  padding: 24rpx;
}
.wip-text {
  font-size: 26rpx;
  color: #E07B00;
}