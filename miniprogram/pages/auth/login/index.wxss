.login-container {
  padding: 80rpx 32rpx 32rpx;
  min-height: 100vh;
  background: #F8F8F8;
}
.logo-section {
  text-align: center;
  padding: 80rpx 0 60rpx;
}
.logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
}
.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #07C160;
  margin-bottom: 8rpx;
}
.app-subtitle {
  font-size: 26rpx;
  color: #999;
}
.form-card {
  padding: 32rpx;
}
.form-item {
  margin-bottom: 32rpx;
}
.label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}
.input {
  width: 100%;
  height: 80rpx;
  padding: 0 16rpx;
  border: 2rpx solid #E8E8E8;
  border-radius: 8rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.login-btn {
  width: 100%;
  margin-top: 16rpx;
}
.error-msg {
  color: #F56565;
  font-size: 26rpx;
  margin-top: 16rpx;
  text-align: center;
}
.footer {
  margin-top: 60rpx;
  text-align: center;
}
.footer-text {
  font-size: 22rpx;
  color: #999;
}