# IELTS Buddy · docker-compose 环境变量模板
# 复制为 .env 后填入真实值（不要提交 .env 到 git）

# === MySQL ===
MYSQL_ROOT_PASSWORD=rootpass_dev_only
MYSQL_USER=ielts_app
MYSQL_PASSWORD=apppass_dev_only
MYSQL_DATABASE=ietls_learn_online

# === LLM（必填，否则 LLM 走 mock） ===
IELTS_BUDDY_LLM_API_KEY=sk-cp-crF61iHIxekGHshefJm0zWb6GFmL0x_tV47xBBYok369iI92IEWjdym7l6UXHXO-EmSyNqtJvd6v3qcjZdS-CoXH63u9Bt3Zl-EcA2mIF8ggnQdARmVp34c
